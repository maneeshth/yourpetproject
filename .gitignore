# ---- Dependencies ----
node_modules/

# ---- Build output ----
dist/
release/
out/
*.blockmap

# ---- Secrets & credentials: NEVER commit these ----
# environment files
.env
.env.*
!.env.example
# code-signing certificates & keys (macOS / Windows signing, if ever added)
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.der
*.mobileprovision
*.provisionprofile
*.keystore
*.jks
# generic secret stores
secrets/
*.secret
*secret*.json
*credentials*.json
*.token
# npm auth tokens
.npmrc
# electron-builder publish config with tokens
electron-builder.env

# ---- Local tool / editor state ----
.claude/settings.local.json
.claude/*.local.*
.vscode/
.idea/
*.swp
*.swo

# ---- Logs & caches ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
.cache/
.eslintcache

# ---- OS cruft ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Source archive this repo was seeded from ----
*.zip
