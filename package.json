{
  "name": "desktop-pet",
  "version": "0.1.0",
  "description": "A tiny open-source desktop pet that chases your cursor. Fully click-through — it never interferes with your work.",
  "main": "main.js",
  "license": "MIT",
  "author": "maneeshth",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.desktoppet",
    "productName": "Desktop Pet",
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "artifactName": "DesktopPet-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "deleteAppDataOnUninstall": true
    }
  }
}
